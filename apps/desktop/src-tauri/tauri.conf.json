{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Solon",
  "version": "0.1.1",
  "identifier": "dev.solon.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Solon",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "French"
        ],
        "installMode": "perMachine",
        "installerHooks": "../../../installer/hooks.nsh",
        "displayLanguageSelector": true
      }
    },
    "resources": {
      "../../../target/release/solon-service.exe": "solon-service.exe",
      "../../../installer/setup.ps1": "installer/setup.ps1",
      "../../../target/release/docker.exe": "bin/docker.exe",
      "../../../installer/vendor/docker-cli.exe": "bin/docker-cli.exe",
      "../../../installer/vendor/cli-plugins/docker-compose.exe": "bin/cli-plugins/docker-compose.exe",
      "../../../installer/vendor/NOTICE-third-party.txt": "bin/NOTICE-third-party.txt",
      "../../../image/out/0.1.0-dev.19/vmlinuz": "image/vmlinuz",
      "../../../image/out/0.1.0-dev.19/initrd.img": "image/initrd.img",
      "../../../image/out/0.1.0-dev.19/rootfs.vhd": "image/rootfs.vhd",
      "../../../image/out/0.1.0-dev.19/manifest.json": "image/manifest.json"
    },
    "licenseFile": "../../../LICENSE",
    "publisher": "Solon"
  }
}
