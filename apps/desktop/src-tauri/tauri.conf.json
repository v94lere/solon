{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Solon",
  "version": "0.2.0",
  "identifier": "dev.solon.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "French"
        ],
        "installMode": "perMachine",
        "installerHooks": "../../../installer/hooks.nsh",
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp"
      }
    },
    "resources": {
      "../../../target/release/solon-service.exe": "solon-service.exe",
      "../../../installer/setup.ps1": "installer/setup.ps1",
        "../../../installer/setup-features.ps1": "installer/setup-features.ps1",
      "../../../target/release/docker.exe": "bin/docker.exe",
      "../../../target/release/solon-cli.exe": "bin/solon.exe",
      "../../../installer/vendor/docker-cli.exe": "bin/docker-cli.exe",
      "../../../installer/vendor/cli-plugins/docker-compose.exe": "bin/cli-plugins/docker-compose.exe",
      "../../../installer/vendor/NOTICE-third-party.txt": "bin/NOTICE-third-party.txt",
      "../../../image/out/0.1.0-dev.23/vmlinuz": "image/vmlinuz",
      "../../../image/out/0.1.0-dev.23/initrd.img": "image/initrd.img",
      "../../../image/out/0.1.0-dev.23/rootfs.vhd": "image/rootfs.vhd",
      "../../../image/out/0.1.0-dev.23/manifest.json": "image/manifest.json"
    },
    "licenseFile": "../../../LICENSE",
    "publisher": "Solon"
  }
}
