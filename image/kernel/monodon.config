# Fragment de configuration Monodon, fusionné par-dessus Microsoft/config-wsl du noyau WSL2.
# Règle : tout ce dont Monodon dépend est en dur (=y), aucun module à charger au démarrage.

CONFIG_LOCALVERSION="-monodon"
CONFIG_LOCALVERSION_AUTO=n

# --- Requis par Docker / containerd, en modules dans la config WSL ---
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VETH=y
CONFIG_EROFS_FS=y

# --- Diagnostic : configuration lisible dans l'invité ---
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- Retirés : sans objet pour un moteur de conteneurs sans écran ni périphériques ---
CONFIG_DXGKRNL=n
CONFIG_SOUND=n
CONFIG_SND=n
CONFIG_DRM=n
CONFIG_USB_SUPPORT=n
CONFIG_HID=n
CONFIG_INPUT_MOUSE=n
CONFIG_INPUT_KEYBOARD=n
CONFIG_HYPERV_KEYBOARD=n
CONFIG_FB=n
CONFIG_VT=n
CONFIG_WIRELESS=n
CONFIG_BT=n
CONFIG_NFC=n
